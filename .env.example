# Token bot kontrol (Developer Portal > aplikasi > Bot > Reset Token)
BOT_TOKEN=
# User ID Discord yang boleh memakai bot, pisah koma
OWNER_IDS=
# Opsional: ID channel untuk pemberitahuan. Kosong = DM ke owner pertama
LOG_CHANNEL_ID=
# Jeda antar login akun (ms). Naikkan kalau banyak akun kena rate limit
LOGIN_GAP_MS=5000
